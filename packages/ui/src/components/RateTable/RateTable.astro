---
// A rate table: one row per cost model (a system or material at a tier), with its per-unit range, typical
// value, how many sources back it and when they were checked. The row the ribbon above is showing is marked.
// It stays a real table at every width; on a phone the tier folds under the system name to make room.
import type { CostUnit, Tier } from '@mm/core/schema';
import { formatDate, formatInr, perUnit } from '../../lib/format.ts';
import { uid } from '../../lib/uid.ts';
import InrRange from '../InrRange/InrRange.astro';

interface Row {
  id: string;
  label: string;
  tier: Tier;
  low: number;
  expected: number;
  high: number;
  sources: number;
  /** The most recent retrieval date among the row's sources (ISO). */
  checkedAt: string;
  current?: boolean;
}

interface Props {
  caption: string;
  unit: CostUnit;
  rows: readonly Row[];
  class?: string;
}

const TIER: Record<Tier, string> = { budget: 'Budget', standard: 'Standard', premium: 'Premium' };
const { caption, unit, rows, class: className } = Astro.props;
const captionId = uid('mm-rates');
---

<div class:list={['mm-rates', className]} role="region" aria-labelledby={captionId} tabindex="0">
  <table>
    <caption id={captionId}>{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="mm-label">System</th>
        <th scope="col" class="mm-label mm-rates__num">Rate {perUnit(unit)}</th>
        <th scope="col" class="mm-label mm-rates__num">Typical</th>
        <th scope="col" class="mm-label">Sources</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr data-model={row.id} data-current={row.current ? '' : undefined}>
            <th scope="row">
              <span class="mm-rates__name">{row.label}</span>
              <span class="mm-rates__tier">
                {TIER[row.tier]}
                {row.current && <span class="mm-rates__here"> · shown above</span>}
              </span>
            </th>
            <td class="mm-rates__num">
              <InrRange low={row.low} high={row.high} />
            </td>
            <td class="mm-rates__num">{formatInr(row.expected)}</td>
            <td class="mm-rates__src">
              {row.sources}
              <span>
                checked <time datetime={row.checkedAt}>{formatDate(row.checkedAt)}</time>
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style is:global>
  .mm-rates {
    overflow-x: auto;
    border: 1px solid var(--mm-line);
    border-radius: var(--mm-radius-m);
    background: var(--mm-raised);
  }

  .mm-rates table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--mm-step--1);
    line-height: 1.35;
  }

  .mm-rates caption {
    padding: var(--mm-space-4) var(--mm-space-4) var(--mm-space-2);
    font-family: var(--mm-font-display);
    font-size: var(--mm-step-0);
    font-weight: 600;
    text-align: left;
  }

  .mm-rates th,
  .mm-rates td {
    padding: var(--mm-space-3) var(--mm-space-4);
    text-align: left;
    vertical-align: top;
  }

  .mm-rates thead th {
    padding-block: var(--mm-space-2);
    border-bottom: 1px solid var(--mm-line-strong);
    white-space: nowrap;
  }

  .mm-rates tbody tr + tr {
    border-top: 1px solid var(--mm-line);
  }

  .mm-rates tbody th {
    display: grid;
    font-weight: 700;
  }

  .mm-rates__tier {
    font-weight: 500;
    color: var(--mm-ink-2);
  }

  .mm-rates__here {
    color: var(--mm-ribbon);
    font-weight: 700;
  }

  .mm-rates__num {
    font-family: var(--mm-font-display);
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }

  td.mm-rates__num {
    font-size: var(--mm-step-0);
    font-weight: 600;
  }

  .mm-rates__src {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .mm-rates__src span {
    display: block;
    font-weight: 500;
    color: var(--mm-ink-2);
    white-space: nowrap;
  }

  /* The model the ribbon is showing: a ribbon node in the margin of its row. */
  .mm-rates tr[data-current] th {
    position: relative;
  }

  .mm-rates tr[data-current] th::before {
    content: '';
    position: absolute;
    top: calc(var(--mm-space-3) + 0.35em);
    left: 0.375rem;
    width: 0.5rem;
    height: 0.5rem;
    border: 2px solid var(--mm-ribbon);
    border-radius: 50%;
  }

  @media (max-width: 30rem) {
    .mm-rates th,
    .mm-rates td {
      padding-inline: var(--mm-space-3);
    }

    .mm-rates tr[data-current] th::before {
      left: 0.125rem;
    }
  }
</style>
