---
// A single choice set as chips: BHK presets, timelines, tiers. Real radio inputs inside labels, so it works
// without JavaScript, with the keyboard (arrow keys move within the group) and with a screen reader.
interface Option {
  value: string;
  label: string;
  /** A second line ("1,000 sq ft"). */
  detail?: string | null;
  /** Rendered hidden: for a choice a script reveals once it can serve it. */
  hidden?: boolean;
}

interface Props {
  name: string;
  legend: string;
  options: readonly Option[];
  /** The checked value; none when left out. */
  value?: string | null;
  required?: boolean;
  class?: string;
}

const { name, legend, options, value = null, required = false, class: className } = Astro.props;
---

<fieldset class:list={['mm-chips', className]}>
  <legend class="mm-label">{legend}</legend>
  <div class="mm-chips__row">
    {
      options.map((option) => (
        <label class="mm-chip" hidden={option.hidden}>
          <input
            type="radio"
            name={name}
            value={option.value}
            checked={option.value === value}
            required={required}
          />
          <span class="mm-chip__label">{option.label}</span>
          {option.detail && <span class="mm-chip__detail">{option.detail}</span>}
        </label>
      ))
    }
  </div>
</fieldset>

<style is:global>
  .mm-chips {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mm-chips > legend {
    padding: 0;
    margin-bottom: var(--mm-space-2);
  }

  .mm-chips__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mm-space-2);
  }

  .mm-chip {
    position: relative;
    display: inline-grid;
    align-content: center;
    min-height: var(--mm-tap);
    padding: 0.375rem 0.875rem;
    border: 1.5px solid var(--mm-line-strong);
    border-radius: var(--mm-radius-s);
    background: var(--mm-raised);
    line-height: 1.25;
    cursor: pointer;
    transition:
      border-color var(--mm-dur-1) var(--mm-ease),
      background-color var(--mm-dur-1) var(--mm-ease);
  }

  .mm-chip[hidden] {
    display: none;
  }

  .mm-chip > input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .mm-chip:hover {
    border-color: var(--mm-ink-2);
  }

  .mm-chip:has(input:checked) {
    border-color: var(--mm-ribbon);
    background: var(--mm-ribbon-wash);
    box-shadow: inset 0 0 0 1px var(--mm-ribbon);
  }

  .mm-chip:has(input:focus-visible) {
    outline: 2px solid var(--mm-focus);
    outline-offset: 2px;
  }

  .mm-chip__label {
    font-size: var(--mm-step--1);
    font-weight: 700;
  }

  .mm-chip__detail {
    font-size: var(--mm-step--2);
    font-variant-numeric: tabular-nums;
    color: var(--mm-ink-2);
  }

  @media (forced-colors: active) {
    .mm-chip:has(input:checked) {
      border-width: 3px;
      border-color: Highlight;
    }
  }
</style>
