---
// One dated source node on the ribbon. The summary row says who, what figure and when it was checked; tapping
// it unfolds the source slip in place: the quote as retrieved, the page it came from, the retrieval date.
// A <details>, so it works without JavaScript and its summary is the accessible name.
// A stale source keeps its place on the line but its figure is struck through and the node turns signal.
import { formatDate } from '../../lib/format.ts';
import Icon from '../Icon/Icon.astro';
import type { SlipSource } from './types.ts';

type Props = SlipSource & { open?: boolean; class?: string };

const { source, figure = null, scope = null, stale = false, open = false, class: className } = Astro.props;
const checked = formatDate(source.retrieved_at);
---

<li class:list={['mm-ev__step', className]} data-line={stale ? 'stale' : 'solid'}>
  <span class="mm-ev__node" data-node={stale ? 'stale' : 'source'} aria-hidden="true"></span>
  <details class="mm-slip" open={open}>
    <summary>
      <span class="mm-slip__who">{source.publisher}</span>
      {figure && (stale ? <s class="mm-slip__fig">{figure}</s> : <span class="mm-slip__fig">{figure}</span>)}
      <Icon name="chevron" size={18} class="mm-slip__chev" />
      <span class="mm-slip__when">
        {
          stale ? (
            <>
              <strong class="mm-slip__stale">Outdated</strong> · checked{' '}
            </>
          ) : (
            'Checked '
          )
        }<time datetime={source.retrieved_at}>{checked}</time>{scope && ` · ${scope}`}
      </span>
    </summary>
    <div class="mm-slip__fold">
      <div class="mm-slip__body">
        {
          source.quote && (
            <blockquote class="mm-slip__quote" cite={source.url}>
              <p>“{source.quote}”</p>
            </blockquote>
          )
        }
        <p class="mm-slip__cite">
          <a href={source.url} rel="noopener external">
            {source.title}
            <Icon name="external" size={16} />
          </a>
          <span>Retrieved <time datetime={source.retrieved_at}>{checked}</time></span>
        </p>
      </div>
    </div>
  </details>
</li>

<style is:global>
  .mm-slip > summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    column-gap: var(--mm-space-3);
    min-height: var(--mm-tap);
    margin-left: calc(var(--mm-space-2) * -1);
    padding: 0.375rem var(--mm-space-2);
    border-radius: var(--mm-radius-s);
    transition: background-color var(--mm-dur-1) var(--mm-ease);
  }

  .mm-slip > summary:hover {
    background: var(--mm-surface);
  }

  .mm-slip__who {
    grid-area: 1 / 1;
    min-width: 0;
    font-weight: 700;
    line-height: 1.3;
  }

  .mm-slip__fig {
    grid-area: 1 / 2;
    font-family: var(--mm-font-display);
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }

  s.mm-slip__fig {
    color: var(--mm-ink-2);
    text-decoration: line-through 2px var(--mm-signal);
  }

  .mm-slip__chev {
    grid-area: 1 / 3;
    color: var(--mm-ink-2);
    transition: rotate var(--mm-dur-2) var(--mm-ease);
  }

  .mm-slip[open] .mm-slip__chev {
    rotate: 180deg;
  }

  .mm-slip__when {
    grid-column: 1 / -1;
    font-size: var(--mm-step--1);
    line-height: 1.4;
    color: var(--mm-ink-2);
  }

  .mm-slip__stale {
    color: var(--mm-signal-ink);
  }

  /* The slip unfolds in place; browsers without ::details-content simply open it. */
  .mm-slip::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size var(--mm-dur-2) var(--mm-ease),
      content-visibility var(--mm-dur-2) allow-discrete;
  }

  .mm-slip[open]::details-content {
    block-size: auto;
  }

  .mm-slip__fold {
    padding: var(--mm-space-3) 0 var(--mm-space-2);
  }

  .mm-slip__body {
    position: relative;
    display: grid;
    gap: var(--mm-space-3);
    padding: var(--mm-space-4);
    border: 1px solid var(--mm-line);
    border-radius: var(--mm-radius-s);
    background: var(--mm-raised);
    box-shadow:
      0 1px 1px var(--mm-shade),
      0 12px 28px -22px var(--mm-shade);
  }

  /* The slip's tab, pointing back up at its node. */
  .mm-slip__body::before {
    content: '';
    position: absolute;
    top: -0.4rem;
    left: 0.875rem;
    width: 0.75rem;
    height: 0.75rem;
    border: solid var(--mm-line);
    border-width: 1px 0 0 1px;
    background: inherit;
    rotate: 45deg;
  }

  .mm-slip__quote {
    font-size: var(--mm-step-0);
    line-height: 1.5;
  }

  .mm-slip__cite {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mm-space-1) var(--mm-space-4);
    font-size: var(--mm-step--1);
    color: var(--mm-ink-2);
  }

  .mm-slip__cite a {
    font-weight: 600;
  }

  .mm-slip__cite .mm-icon {
    margin-left: 0.25rem;
    vertical-align: -0.2em;
  }
</style>
