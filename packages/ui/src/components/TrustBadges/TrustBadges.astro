---
// Trust labels (CONTRACTS §3 TrustLabel) from C03 trustLabels(): each is a check the data passed, so each
// reads as a seal, never as a star or score.
import type { TrustLabel } from '@mm/core/schema';
import { formatDate } from '../../lib/format.ts';
import { TRUST_TEXT } from '../../lib/labels.ts';
import Icon from '../Icon/Icon.astro';

interface Props {
  labels: readonly TrustLabel[];
  /** When the most recent check happened (ISO). Shown after the list. */
  checkedAt?: string | null;
  class?: string;
}

const { labels, checkedAt = null, class: className } = Astro.props;
---

{
  labels.length > 0 && (
    <ul class:list={['mm-trust', className]} aria-label="Checks this listing passed">
      {labels.map((label) => (
        <li class="mm-trust__item" data-trust={label}>
          <Icon name="seal" size={18} />
          {TRUST_TEXT[label]}
        </li>
      ))}
      {checkedAt && (
        <li class="mm-trust__when">
          Checked <time datetime={checkedAt}>{formatDate(checkedAt)}</time>
        </li>
      )}
    </ul>
  )
}

<style is:global>
  .mm-trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mm-space-1) var(--mm-space-4);
    padding: 0;
    list-style: none;
    font-size: var(--mm-step--1);
    line-height: 1.4;
    color: var(--mm-ink-2);
  }

  .mm-trust__item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--mm-ink);
    font-weight: 600;
  }

  .mm-trust__item .mm-icon {
    color: var(--mm-ribbon);
  }
</style>
