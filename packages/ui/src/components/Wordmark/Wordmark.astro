---
// "MarketMind AI" set in Space Grotesk beside the ribbon-bookmark mark. A link home when `href` is given.
import { MARK_FROM, MARK_NODE, MARK_RIBBON, MARK_TO, MARK_VIEWBOX } from '../../lib/mark.ts';
import { uid } from '../../lib/uid.ts';

interface Props {
  href?: string;
  size?: 'md' | 'lg';
  class?: string;
}

const { href, size = 'md', class: className } = Astro.props;
const gradient = uid('mm-mark');
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['mm-wordmark', `mm-wordmark--${size}`, className]} href={href}>
  <svg class="mm-wordmark__mark" viewBox={MARK_VIEWBOX} aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gradient} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={MARK_FROM}></stop>
        <stop offset="1" stop-color={MARK_TO}></stop>
      </linearGradient>
    </defs>
    <path d={MARK_RIBBON} fill={`url(#${gradient})`}></path>
    <circle cx={MARK_NODE.cx} cy={MARK_NODE.cy} r={MARK_NODE.r} fill="none" stroke="#fff" stroke-width="2.4"></circle>
  </svg>
  <span class="mm-wordmark__name">MarketMind AI</span>
</Tag>

<style is:global>
  .mm-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--mm-ink);
    font-family: var(--mm-font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .mm-wordmark:hover {
    color: var(--mm-ink);
  }

  .mm-wordmark__mark {
    width: 0.95em;
    height: 1.27em;
  }

  .mm-wordmark--lg {
    font-size: 1.625rem;
  }
</style>
