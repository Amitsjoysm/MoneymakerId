---
// UI fixture: the first viewport of a construction cost page and the start of the section below, built from
// real data: the terrace waterproofing cost models in data/cost-models/waterproofing.json and the terrace
// presets in data/services/waterproofing.json, with their own sources and dates. There is no sourced locality
// factor yet, so this is the Pune city page and says "Pune-wide rate"; it never implies a locality price.
// Nothing here is invented. Rendered by apps/construction/src/pages/ui-fixtures/[x].astro (noindex).
import { estimate } from '@mm/core/cost';
import { ctaCopy, refCode, whatsappUrl } from '@mm/core/leads';
import { CostModelSchema, ServiceDefSchema } from '@mm/core/schema';
import { breadcrumbListJsonLd } from '@mm/core/seo';
import modelsJson from '../../../data/cost-models/waterproofing.json';
import packJson from '../../../data/services/waterproofing.json';
import Breadcrumbs from '../src/components/Breadcrumbs/Breadcrumbs.astro';
import Button from '../src/components/Button/Button.astro';
import Card from '../src/components/Card/Card.astro';
import Disclosure from '../src/components/Disclosure/Disclosure.astro';
import EvidenceRibbon from '../src/components/EvidenceRibbon/EvidenceRibbon.astro';
import RibbonClaim from '../src/components/EvidenceRibbon/RibbonClaim.astro';
import RibbonEstimate from '../src/components/EvidenceRibbon/RibbonEstimate.astro';
import RibbonSplit from '../src/components/EvidenceRibbon/RibbonSplit.astro';
import SourceBundle from '../src/components/EvidenceRibbon/SourceBundle.astro';
import SourceSlip from '../src/components/EvidenceRibbon/SourceSlip.astro';
import type { EstimatePreset, SlipSource } from '../src/components/EvidenceRibbon/types.ts';
import Footer from '../src/components/Footer/Footer.astro';
import Header from '../src/components/Header/Header.astro';
import InrRange from '../src/components/InrRange/InrRange.astro';
import RateTable from '../src/components/RateTable/RateTable.astro';
import StickyActionBar from '../src/components/StickyActionBar/StickyActionBar.astro';
import WhatsAppButton from '../src/components/WhatsAppButton/WhatsAppButton.astro';
import BaseLayout from '../src/layouts/BaseLayout.astro';
import { formatDate, formatInr } from '../src/lib/format.ts';

const SITE = 'https://construction.marketmindai.com';
const SERVICE_ID = 'terrace-waterproofing';
const MODEL_ID = 'terrace-waterproofing-acrylic-coating-budget';

const models = CostModelSchema.array().parse(modelsJson);
const pack = ServiceDefSchema.parse(packJson);
const service = pack.sub_services.find((s) => s.id === SERVICE_ID);
const model = models.find((m) => m.id === MODEL_ID);
if (!service || !model) throw new Error('cost-page fixture: terrace waterproofing data is missing');

/** The model's five sources, each with the figure its own quote gives and where it says it applies. */
const bySource = (publisher: string) => {
  const source = model.sources.find((s) => s.publisher === publisher);
  if (!source) throw new Error(`cost-page fixture: no source from ${publisher}`);
  return source;
};
const shown: SlipSource[] = [
  { source: bySource('NoBroker'), figure: '₹35–₹60', scope: 'Pune' },
  { source: bySource('Pidilite Industries (Dr. Fixit)'), figure: '₹35–₹45' },
  { source: bySource('Asian Paints'), figure: '₹60–₹100', scope: 'India' },
];
const folded: SlipSource[] = [
  { source: bySource('AapkaPainter'), figure: '₹55' },
  { source: bySource('IndiaMART'), figure: '₹55', scope: 'Pune' },
];

/** The presets the sub-service defines, priced by the cost engine. */
const CHIP: Record<string, { label: string; note: string }> = {
  terrace: { label: 'Terrace', note: 'an example size, so measure yours with the parapets' },
  independent_house: { label: 'House roof', note: 'roof taken as the house footprint, plus parapets' },
};
const presets: EstimatePreset[] = service.area_presets.map((preset) => {
  const result = estimate(model, { area: { preset: preset.preset }, service });
  if (!result.ok) throw new Error(`cost-page fixture: ${result.error.code}`);
  const chip = CHIP[preset.preset];
  if (!chip) throw new Error(`cost-page fixture: no chip text for ${preset.preset}`);
  return {
    value: preset.preset,
    label: chip.label,
    detail: `${new Intl.NumberFormat('en-IN').format(preset.quantity)} sq ft`,
    low: result.value.low,
    expected: result.value.expected,
    high: result.value.high,
    note: chip.note,
  };
});

/** The other terrace systems, for the table below the fold. */
const LABEL: Record<string, string> = {
  'acrylic-roof-coating': 'Acrylic coating',
  'liquid-applied-membrane': 'Liquid membrane',
  'app-membrane': 'APP membrane',
  'pu-membrane': 'PU membrane',
  'brickbat-coba': 'Brickbat coba',
};
const materials = new Map(service.materials.map((m) => [m.id, m.label]));
const rows = models
  .filter((m) => m.service_id === SERVICE_ID)
  .map((m) => ({
    id: m.id,
    label: LABEL[m.material_id ?? ''] ?? materials.get(m.material_id ?? '') ?? m.id,
    tier: m.tier,
    low: m.rate_inr.low,
    expected: m.rate_inr.expected,
    high: m.rate_inr.high,
    sources: m.sources.length,
    checkedAt: m.sources.map((s) => s.retrieved_at).sort().at(-1)!,
    current: m.id === MODEL_ID,
  }))
  .sort((a, b) => a.expected - b.expected);

const scope = service.scope_options.find((s) => s.id === model.scope_id);
const checked = model.sources.map((s) => s.retrieved_at).sort().at(-1)!;

const ref = refCode({ localityId: null, serviceId: SERVICE_ID });
const cta = ctaCopy({ acceptingProviders: 0, service: 'terrace waterproofing', locality: null });
const quoteHref = whatsappUrl({ text: "Hi, I'd like a quote for terrace waterproofing in Pune.", ref });
const reportHref = whatsappUrl({
  text: 'A figure on your terrace waterproofing cost page for Pune looks outdated:',
  ref,
});

const crumbs = [
  { label: 'Pune', href: '/pune/', place: true },
  { label: 'Waterproofing', href: '/pune/waterproofing-cost/' },
  { label: 'Terrace waterproofing' },
];
const seo = {
  title: 'UI fixture: Terrace Waterproofing Cost in Pune | MarketMind AI',
  description: 'Design-system fixture of the construction cost page, built from the real terrace waterproofing models.',
  canonical: `${SITE}/ui-fixtures/cost-page/`,
  robots: 'noindex, nofollow',
  jsonLd: breadcrumbListJsonLd(
    crumbs.map((c) => ({ name: c.label, url: `${SITE}${c.href ?? '/pune/terrace-waterproofing-cost/'}` })),
  ),
};
const nav = [
  { label: 'Cost guides', href: '/pune/', current: true },
  { label: 'Cost calculator', href: '/cost-calculator/' },
  { label: 'For contractors', href: '/for-contractors/' },
];
---

<BaseLayout host="construction" pageType="service_cost" subject={SERVICE_ID} seo={seo}>
  <Header slot="header" homeHref="/" section="Construction costs" nav={nav} />

  <div class="mm-page cp">
    <Breadcrumbs items={crumbs} class="cp__crumbs" />

    <div class="cp__grid">
      <div class="cp__answer">
        <h1 class="cp__title">Terrace waterproofing cost in Pune</h1>

        <EvidenceRibbon label="How this rate is sourced">
          <RibbonClaim low={model.rate_inr.low} high={model.rate_inr.high} unit={model.unit} typical={model.rate_inr.expected} place="Pune-wide rate">
            <p class="cp__scope">Acrylic roof coating over a sound terrace, budget tier. The sources disagree, so the range spans them.</p>
          </RibbonClaim>
          {shown.map((s) => <SourceSlip {...s} />)}
          <SourceBundle sources={folded} />
          <RibbonEstimate
            rate={{ ...model.rate_inr, min_job_inr: model.min_job_inr }}
            unit={model.unit}
            presets={presets}
            note="Our arithmetic, not a source: the rate above times the area, rounded to the nearest ₹100."
          />
          <RibbonSplit stickyHide>
            <WhatsAppButton slot="primary" href={quoteHref}>Get a free quote on WhatsApp</WhatsAppButton>
            <Button slot="secondary" variant="quiet" icon="flag" href={reportHref}>Report outdated</Button>
          </RibbonSplit>
        </EvidenceRibbon>

        <div class="cp__small">
          <p>{cta.microcopy}</p>
          <Disclosure kind="cost" />
        </div>
      </div>

      <aside class="cp__record" aria-labelledby="cp-record">
        <Card tone="surface" tab>
          <h2 id="cp-record" class="cp__record-title">The record behind this rate</h2>
          <dl class="cp__facts">
            <div>
              <dt class="mm-label">Cost model</dt>
              <dd>Acrylic roof coating, budget tier</dd>
            </div>
            <div>
              <dt class="mm-label">Rate</dt>
              <dd><InrRange low={model.rate_inr.low} high={model.rate_inr.high} /> per sq ft, typical {formatInr(model.rate_inr.expected)}</dd>
            </div>
            {
              scope && (
                <div>
                  <dt class="mm-label">Covers</dt>
                  <dd>{scope.description}</dd>
                </div>
              )
            }
            <div>
              <dt class="mm-label">Sources</dt>
              <dd>{model.sources.length}, all retrieved <time datetime={checked}>{formatDate(checked)}</time></dd>
            </div>
            <div>
              <dt class="mm-label">Re-check by</dt>
              <dd><time datetime={model.valid_until}>{formatDate(model.valid_until)}</time></dd>
            </div>
            <div>
              <dt class="mm-label">Status</dt>
              <dd class="cp__status">Draft: compiled from the sources, awaiting editor review</dd>
            </div>
          </dl>
          <p class="cp__method">
            How the range was set: each figure comes from a source above. Typical is the median of the sources' midpoints, rounded to ₹5.
          </p>
        </Card>
      </aside>
    </div>

    <section class="cp__systems" aria-labelledby="cp-systems">
      <h2 id="cp-systems" class="mm-section-title">Cost by waterproofing system</h2>
      <p class="cp__lede">
        The system sets most of the price. These are the five terrace systems we hold cost models for, each priced per sq ft from its
        own sources. The coating above has the lowest typical rate; a PU membrane's typical rate is about four times higher.
      </p>
      <RateTable caption="Terrace waterproofing rates in Pune by system" unit="sqft" rows={rows} />
    </section>
  </div>

  <Footer
    slot="footer"
    homeHref="/"
    links={[
      { label: 'About', href: 'https://marketmindai.com/about/' },
      { label: 'Editorial policy', href: 'https://marketmindai.com/editorial-policy/' },
      { label: 'Privacy', href: 'https://marketmindai.com/privacy/' },
      { label: 'Terms', href: 'https://marketmindai.com/terms/' },
      { label: 'Contact', href: 'https://marketmindai.com/contact/' },
    ]}
  />

  <StickyActionBar slot="after" label="Quick quote" title="₹35–₹100 per sq ft" detail="Pune-wide rate, typical ₹55">
    <WhatsAppButton href={quoteHref} size="md">Get a quote</WhatsAppButton>
  </StickyActionBar>
</BaseLayout>

<!-- Page layout of the fixture, unscoped: its classes are unique to this page. -->
<style is:global>
  .cp {
    padding-top: var(--mm-space-3);
  }

  .cp__crumbs {
    margin-bottom: var(--mm-space-2);
  }

  .cp__title {
    margin-bottom: var(--mm-space-5);
  }

  .cp__scope {
    max-width: 36rem;
    margin-top: var(--mm-space-3);
    font-size: var(--mm-step--1);
    color: var(--mm-ink-2);
  }

  .cp__small {
    display: grid;
    gap: var(--mm-space-2);
    margin-top: var(--mm-space-5);
    padding-left: var(--mm-rail);
    font-size: var(--mm-step--1);
    color: var(--mm-ink-2);
  }

  .cp__grid {
    display: grid;
    gap: var(--mm-space-7);
  }

  .cp__record-title {
    font-size: var(--mm-step-1);
  }

  .cp__facts {
    display: grid;
    margin-top: var(--mm-space-4);
    font-size: var(--mm-step--1);
  }

  .cp__facts > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--mm-space-3);
    padding-block: var(--mm-space-2);
    border-top: 1px solid var(--mm-line);
  }

  .cp__facts dt {
    padding-top: 0.15em;
  }

  .cp__facts dd {
    font-weight: 600;
  }

  .cp__status {
    color: var(--mm-ink-2);
  }

  .cp__method {
    margin-top: var(--mm-space-3);
    padding-top: var(--mm-space-3);
    border-top: 1px dashed var(--mm-line-strong);
    font-size: var(--mm-step--1);
    color: var(--mm-ink-2);
  }

  .cp__systems {
    display: grid;
    gap: var(--mm-space-4);
    margin-top: var(--mm-space-8);
    padding-bottom: var(--mm-space-4);
  }

  .cp__lede {
    max-width: var(--mm-measure);
    color: var(--mm-ink-2);
  }

  @media (min-width: 64rem) {
    .cp {
      padding-top: var(--mm-space-5);
    }

    .cp__crumbs {
      margin-bottom: var(--mm-space-4);
    }

    .cp__grid {
      grid-template-columns: minmax(0, 46rem) minmax(17rem, 22rem);
      justify-content: space-between;
      gap: var(--mm-space-8);
    }

    .cp__record {
      position: sticky;
      top: var(--mm-space-5);
      align-self: start;
      margin-top: 0.5rem;
    }
  }
</style>
