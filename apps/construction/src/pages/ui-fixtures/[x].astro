---
// Design-system fixtures (T03). Built only when DATA_SOURCE=fixtures (CI, local UI work), never in a
// production build, and always noindex: they exist for the accessibility, contrast, CSS-budget and visual
// checks. `components` shows every component in every state, light and dark; `cost-page` is the first
// viewport of the construction cost page built from the real terrace waterproofing data.
import Components from '../../../../../packages/ui/fixtures/components.astro';
import CostPage from '../../../../../packages/ui/fixtures/cost-page.astro';

export function getStaticPaths() {
  if (import.meta.env.DATA_SOURCE !== 'fixtures') return [];
  return [{ params: { x: 'components' } }, { params: { x: 'cost-page' } }];
}

const { x } = Astro.params;
---

{x === 'components' ? <Components /> : <CostPage />}
